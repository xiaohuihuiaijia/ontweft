# Copy outside version control and replace every placeholder.
# URL-safe random strings are required by the database connection URL.
POSTGRES_PASSWORD=replace-with-random-owner-password
RUNTIME_PASSWORD=replace-with-different-random-runtime-password
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key
ALLOWED_ORIGINS=["https://ontweft.example.com"]
PORT=8000
# One API service; increase workers only after measuring the target host/load.
API_WORKERS=1
# Compose defaults to core-only. Install optional SDKs before enabling integrations.
# ONTWEFT_IMAGE=ontweft:local
